{
  "name": "stable-desk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A generic stablecoin research workspace with public market context and fictional demo examples.",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "preview": "node scripts/server.mjs --dist",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:pilot": "playwright test --config playwright.pilot.config.js",
    "dev:pilot": "node scripts/pilot-fixture.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build": "node scripts/build.mjs",
    "package": "python3 scripts/package.py",
    "audit:content": "python3 scripts/audit-content.py",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.58.2"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  }
}
